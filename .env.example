# Copy to .env (docker compose) and for the backend (apps/backend/.env). Nothing here is a secret.
# Host directory with tracks/<build>/all/*.parquet (and raw/<build>.fa + .fai for the sequence endpoints)
TRACKS_DIR=./data
# Origins the browser may call the API from (comma-separated, or * for development)
CORS_ORIGINS=http://localhost:3000
# URL the browser uses to reach the API; compiled into the web image at build time
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Optional DuckDB limits for small machines (empty = DuckDB defaults)
DUCKDB_THREADS=
DUCKDB_MEMORY_LIMIT=
WEB_CONCURRENCY=1
